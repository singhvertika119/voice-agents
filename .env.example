# LiveKit Cloud (free project): https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI (STT/TTS): https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Groq (free model): https://console.groq.com/keys
# Needed: the free model answers calls when a workspace has no working OpenAI key, and does all background work
# (summaries, test conversations, Ask in chat) unless the workspace chose "Everything" for its key (D-124, D-125).
GROQ_API_KEY=

# Deepgram (signup credit): https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional backups
GEMINI_API_KEY=        # last backup model (Google AI Studio free tier: https://aistudio.google.com/apikey)
CARTESIA_API_KEY=      # backup voice

# Supabase (NEW project for this platform; do not reuse another app's project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts tool credentials and workspace OpenAI keys. Generate once and never change it, or saved keys stop working:
#   uv run python -c "from vp_core.secrets import new_key; print(new_key())"
TOOL_SECRET_KEY=

# Optional: only for the worker's platform mode (UUID of a published agent)
# AGENT_ID=

# ---- Optional knobs (defaults shown; leave unset unless you need to change one) ----
# AGENT_NAME=voice-platform          # the worker's LiveKit name; the dashboard dispatches to it
# BACKGROUND_URL=https://voice-background.onrender.com   # where the dashboard asks for question embeddings
# NEXT_PUBLIC_SITE_URL=              # the dashboard's public address, for email links
# FREE_LLM_MODEL=openai/gpt-oss-120b # Groq model for background work
# LLM_TEMPERATURE=0.2
# SUMMARY_MODEL=gpt-4.1-mini         # end-of-call summary, when the workspace key is used for everything
# EVAL_MODEL=gpt-4.1-mini            # test caller
# EVAL_JUDGE_MODEL=gpt-4.1           # test reviewer
# EVAL_CONCURRENCY=3                 # test conversations at a time
# NIGHTLY_TESTS=weekly               # on | weekly | off
# NIGHTLY_RUNS=1
# RUN_TEST_WORKER=1                  # 0 = the background server does not run tests
# RETRANSCRIBE=1                     # re-transcribe the caller from the recording after the call
# KNOWLEDGE_PROMPT_TOKENS / KNOWLEDGE_CORE_TOKENS   # knowledge size limits for the prompt
# WEBSITE_MAX_PAGES / WEBSITE_REFRESH_DAYS          # website import limits
# EMBED_THREADS                      # CPU threads for the embedding model
# OUTBOUND_TRUNK_ID= / OUTBOUND_FROM_NUMBER=        # scripts/call_me.py only
